{
    "groups": [
        {
            "id": "general",
            "settings": [
                {
                    "id": "aspectRatio",
                    "label": "Соотношение сторон",
                    "type": "select",
                    "options": [
                        { "value": "9:16", "label": "9:16" },
                        { "value": "16:9", "label": "16:9" },
                        { "value": "1:1", "label": "1:1" },
                        { "value": "3:4", "label": "3:4" },
                        { "value": "4:3", "label": "4:3" }
                    ],
                    "default": "9:16"
                },
                {
                    "id": "resolution",
                    "label": "Разрешение",
                    "type": "select",
                    "options": [
                        { "value": 1080, "label": "1080p" },
                        { "value": 720, "label": "720p" },
                        { "value": 480, "label": "480p" },
                        { "value": 360, "label": "360p" }
                    ],
                    "default": 1080
                }
            ]
        },
        {
            "id": "primaryFontGroup",
            "label": "Основной шрифт (2 столбец)",
            "settings": [
                {
                    "id": "primaryFont",
                    "label": "Шрифт",
                    "type": "select",
                    "options": [
                        { "value": "KFGQPC Uthmanic Script HAFS", "label": "KFGQPC" },
                        { "value": "Inter var", "label": "Inter" }
                    ],
                    "default": "KFGQPC Uthmanic Script HAFS"
                },
                {
                    "id": "primaryFontSize",
                    "label": "Размер",
                    "type": "number",
                    "default": 67,
                    "min": 1,
                    "step": 1
                }
            ]
        },
        {
            "id": "secondaryFontGroup",
            "label": "Дополнительный шрифт (3+ столбец)",
            "settings": [
                {
                    "id": "secondaryFont",
                    "label": "Шрифт",
                    "type": "select",
                    "options": [
                        { "value": "Inter var", "label": "Inter" },
                        { "value": "KFGQPC Uthmanic Script HAFS", "label": "KFGQPC" }
                    ],
                    "default": "Inter var"
                },
                {
                    "id": "secondaryFontSize",
                    "label": "Размер",
                    "type": "number",
                    "default": 39,
                    "min": 1,
                    "step": 1
                }
            ]
        },
        {
            "id": "spacingGroup",
            "settings": [
                 {
                    "id": "textSpacing",
                    "label": "Расстояние между текстами",
                    "type": "number",
                    "default": 40,
                    "min": 0,
                    "step": 1
                }
            ]
        },
        {
            "id": "animationGroup",
            "label": "Анимация текста",
            "settings": [
                {
                    "id": "animationType",
                    "label": "Тип",
                    "type": "select",
                    "options": [
                        { "value": "fade", "label": "Появление/Исчезновение" },
                        { "value": "none", "label": "Без анимации" }
                    ],
                    "default": "fade"
                },
                {
                    "id": "animationDuration",
                    "label": "Длительность (сек)",
                    "type": "number",
                    "default": 0.5,
                    "min": 0,
                    "step": 0.1
                },
                {
                    "id": "animationEasing",
                    "label": "Плавность",
                    "type": "select",
                    "condition": { "id": "animationType", "value": "fade" },
                    "options": [
                        { "value": "linear", "label": "Линейная" },
                        { "value": "easeInQuad", "label": "Ease-In" },
                        { "value": "easeOutQuad", "label": "Ease-Out" },
                        { "value": "easeInOutQuad", "label": "Ease-In-Out" }
                    ],
                    "default": "linear"
                }
            ]
        }
    ]
}
